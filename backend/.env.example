# Copy to .env and fill in real values. Never commit .env.

# Required: random secret used to sign login tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# PostgreSQL 16 with pgvector is required everywhere. scripts/setup_local_services.sh creates the role and both
# databases and fills in these two lines.
DATABASE_URL=postgresql+psycopg://omnireview:CHANGE_ME@localhost:5432/omnireview
# Used only by the test suite, which erases this database on every run. Its name must end in _test.
TEST_DATABASE_URL=postgresql+psycopg://omnireview:CHANGE_ME@localhost:5432/omnireview_test

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Redis for rate-limit counts and the background job queue (installed by scripts/setup_local_services.sh).
REDIS_URL=redis://localhost:6379/0

# Observability: logs are JSON; errors go to Sentry when SENTRY_DSN is set.
APP_ENV=development
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Required to save users' own API keys: 32 random bytes, base64-encoded. Changing it makes saved keys unreadable.
# Generate with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEY=

# Server-wide AI provider keys. Leave a key blank to rely on users' own keys for that provider.
# AI_PLATFORM_KEYS=false makes the server bring-your-own-key only: the keys below are ignored, every AI task needs the
# user's own key, and AI credits no longer apply.
AI_PLATFORM_KEYS=true
# Which models are offered is managed in the ai_models table (seeded by the migrations).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
ZHIPUAI_API_KEY=
MISTRAL_API_KEY=
# Optional endpoint overrides, e.g. QWEN_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1
# Per-provider concurrent calls, attempts per call (retries on rate limits and server errors), and timeouts.
LLM_MAX_CONCURRENCY=5
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_SECONDS=1
LLM_TIMEOUT_SECONDS=150

# Background AI jobs run in a separate worker: uv run arq workers.ai_worker.WorkerSettings (needs REDIS_URL).
AI_WORKER_MAX_JOBS=4
AI_JOB_TIMEOUT_SECONDS=3600

# Literature search (optional, recommended): identifies you to NCBI and OpenAlex and raises rate limits.
NCBI_EMAIL=
NCBI_API_KEY=
OPENALEX_EMAIL=
OPENALEX_API_KEY=
# Optional: identifies you to Crossref (falls back to OPENALEX_EMAIL) and raises Semantic Scholar rate limits.
CROSSREF_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=

# Full texts. Unpaywall requires a contact email (falls back to CROSSREF_EMAIL, then OPENALEX_EMAIL).
UNPAYWALL_EMAIL=
# Where uploaded and retrieved files OmniReview stores itself are kept; defaults to backend/storage/documents. Keep it
# private and backed up. Accounts may instead connect their own S3-compatible bucket in the app (no server setting).
DOCUMENT_STORAGE_DIR=
MAX_DOCUMENT_BYTES=52428800

# Entity linking. MeSH, RxNorm, and ATC need no key. ICD-11 codes need free WHO ICD API credentials
# (https://icd.who.int/icdapi); leave these empty to skip ICD-11.
ICD11_CLIENT_ID=
ICD11_CLIENT_SECRET=
ICD11_RELEASE=2025-01

# Statistics engine (R). Install without sudo with backend/scripts/setup_r_env.sh, which prints the path.
RSCRIPT_PATH=
# Seconds an analysis may run in R before it is stopped.
STATS_TIMEOUT_SECONDS=900

# Manuscript export tools. Install without sudo with backend/scripts/setup_publishing_tools.sh, which prints the paths.
PANDOC_PATH=
TECTONIC_PATH=
RSVG_CONVERT_PATH=
PANDOC_TIMEOUT_SECONDS=600
# Contact address sent to Crossref when verifying references (polite pool).
CROSSREF_MAILTO=

# Where the app is served, used in notification links and invitation emails.
APP_URL=http://localhost:5173

# Email: password resets, email verification, and notifications.
# EMAIL_BACKEND=smtp sends through SMTP_HOST (the default when SMTP_HOST and SMTP_FROM are set). In development,
# EMAIL_BACKEND=console writes each email to the log, and to EMAIL_OUTBOX_DIR when set, so you can follow the links;
# it is refused in production. Without either, production email is off and password resets can't be delivered.
EMAIL_BACKEND=
EMAIL_OUTBOX_DIR=
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Accounts. Require new accounts to confirm their email address before signing in (recommended in production).
REQUIRE_EMAIL_VERIFICATION=false
# The version of docs/legal/terms.md and privacy.md that new accounts accept; change it when those documents change.
TERMS_VERSION=2026-09-16
# Days between asking to delete an account and it being deleted (it can be cancelled until then).
ACCOUNT_DELETION_GRACE_DAYS=14
# The name authenticator apps show for two-factor sign-in.
MFA_ISSUER=OmniReview

# The documentation the help assistant answers from; defaults to the repository's docs folder.
HELP_DOCS_DIR=

# AI governance. With REQUIRE_VALIDATED_MODELS=true, projects can only pin models that passed the benchmark suite.
REQUIRE_VALIDATED_MODELS=false
# Benchmark data sets (JSON); defaults to backend/benchmarks/datasets.
BENCHMARK_DATASETS_DIR=
# Overrides the pass thresholds, for example {"screening": {"recall": 0.98}}.
BENCHMARK_THRESHOLDS=

# What AI on the server's keys costs customers, as a multiple of what the provider charges. The provider's prices are
# entered per model in the administration console; a model without them can only be used with a user's own key.
AI_PRICE_MARKUP=4

# Billing and plan limits (plans are managed in the administration console, /admin).
# With BILLING_ENABLED=false every account is unlimited (self-hosted and development default).
BILLING_ENABLED=false
# manual: an administrator assigns plans (invoiced customers). dev: simulated checkout for development (refused in
# production). stripe: Stripe Checkout, the customer portal, and webhooks at /api/billing/webhooks/stripe.
BILLING_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The plan accounts without a subscription are on, and days a lapsed administrator-assigned plan keeps working.
BILLING_FREE_PLAN=free
BILLING_GRACE_DAYS=7

# Development only: let webhooks reach a receiver on your own machine (scripts/dev_webhook_receiver.py). Refused in
# production.
ALLOW_PRIVATE_WEBHOOK_URLS=false
