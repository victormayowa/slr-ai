# Copy to .env and fill in real values. Never commit .env.

# Required: random secret used to sign login tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# SQLite for local development; PostgreSQL in production.
DATABASE_URL=sqlite:///./omnireview.db

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# AI providers: leave a key blank to disable that provider.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-5
LLM_MAX_CONCURRENCY=5

# Literature search (optional, recommended): identifies you to NCBI and OpenAlex and raises rate limits.
NCBI_EMAIL=
NCBI_API_KEY=
OPENALEX_EMAIL=
OPENALEX_API_KEY=
