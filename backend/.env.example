# Copy to .env and fill in real values. Never commit .env.

# Required: random secret used to sign login tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# PostgreSQL 16 with pgvector is required everywhere. scripts/setup_local_services.sh creates the role and both
# databases and fills in these two lines.
DATABASE_URL=postgresql+psycopg://omnireview:CHANGE_ME@localhost:5432/omnireview
# Used only by the test suite, which erases this database on every run. Its name must end in _test.
TEST_DATABASE_URL=postgresql+psycopg://omnireview:CHANGE_ME@localhost:5432/omnireview_test

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Redis for rate-limit counts and the background job queue (installed by scripts/setup_local_services.sh).
REDIS_URL=redis://localhost:6379/0

# Observability: logs are JSON; errors go to Sentry when SENTRY_DSN is set.
APP_ENV=development
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Required to save users' own API keys: 32 random bytes, base64-encoded. Changing it makes saved keys unreadable.
# Generate with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEY=

# Server-wide AI provider keys. Leave a key blank to rely on users' own keys for that provider.
# Which models are offered is managed in the ai_models table (seeded by the migrations).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
ZHIPUAI_API_KEY=
MISTRAL_API_KEY=
# Optional endpoint overrides, e.g. QWEN_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1
# Per-provider concurrent calls, attempts per call (retries on rate limits and server errors), and timeouts.
LLM_MAX_CONCURRENCY=5
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_SECONDS=1
LLM_TIMEOUT_SECONDS=150

# Background AI jobs run in a separate worker: uv run arq workers.ai_worker.WorkerSettings (needs REDIS_URL).
AI_WORKER_MAX_JOBS=4
AI_JOB_TIMEOUT_SECONDS=3600

# Literature search (optional, recommended): identifies you to NCBI and OpenAlex and raises rate limits.
NCBI_EMAIL=
NCBI_API_KEY=
OPENALEX_EMAIL=
OPENALEX_API_KEY=
# Optional: identifies you to Crossref (falls back to OPENALEX_EMAIL) and raises Semantic Scholar rate limits.
CROSSREF_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=

# Full texts. Unpaywall requires a contact email (falls back to CROSSREF_EMAIL, then OPENALEX_EMAIL).
UNPAYWALL_EMAIL=
# Where uploaded and retrieved files are kept; defaults to backend/storage/documents. Keep it private and backed up.
DOCUMENT_STORAGE_DIR=
MAX_DOCUMENT_BYTES=52428800

# Entity linking. MeSH, RxNorm, and ATC need no key. ICD-11 codes need free WHO ICD API credentials
# (https://icd.who.int/icdapi); leave these empty to skip ICD-11.
ICD11_CLIENT_ID=
ICD11_CLIENT_SECRET=
ICD11_RELEASE=2025-01
