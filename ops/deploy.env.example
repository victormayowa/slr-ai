# Copy to .env in the repository root on the server (never commit it). Docker Compose and ops/deploy.sh both read it.

# The domain the site is served on. Caddy gets the HTTPS certificate for this name on first start.
SITE_ADDRESS=omnireview.duckdns.org

# The password of the PostgreSQL role the API uses. It only ever travels inside the server's Docker network:
# PostgreSQL isn't published to the host or the internet.
POSTGRES_PASSWORD=

# Where ops/backup.sh writes before uploading with restic.
BACKUP_DIR=/var/backups/omnireview
